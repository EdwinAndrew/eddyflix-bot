# Required
DISCORD_TOKEN=your-discord-bot-token
JELLYFIN_API_KEY=your-jellyfin-api-key
JELLYFIN_URL=http://jellyfin:8096

# Channels (right-click a channel → Copy Channel ID, with Developer Mode on). 0 = off
DASHBOARD_CHANNEL_ID=0
ACTIVITY_CHANNEL_ID=0

# Optional
TZ=America/Toronto
UPDATE_INTERVAL=60                          # dashboard refresh, seconds
JELLYFIN_PUBLIC_URL=                        # e.g. https://jellyfin.example.com, linked from movie nights
UPTIME_KUMA_PUSH_URL=                       # Uptime Kuma Push monitor, hit on every good heartbeat
